* text=auto

# Keep source and configuration files consistent across Windows and Linux CI.
*.py text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Preserve Windows-native scripts when they are added.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never perform line-ending conversion on binary files.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
